# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (Aiven Cloud MySQL)
DB_HOST=your-aiven-mysql.aivencloud.com
DB_PORT=25060
DB_USER=avnadmin
DB_PASSWORD=your_db_password
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_CA_PATH=

# JWT Authentication
JWT_SECRET=super_secret_civiclens_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (for database seed)
ADMIN_EMAIL=admin@civiclens.gov
ADMIN_PASSWORD=AdminSecureCivic2025!

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
